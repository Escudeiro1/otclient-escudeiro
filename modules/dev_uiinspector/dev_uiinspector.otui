UiiSectionLabel < UILabel
  height: 12
  font: verdana-11px-monochrome
  color: #8f8f8f
  margin-top: 5

UiiStateCheck < CheckBox
  height: 16
  font: verdana-11px-monochrome
  color: #c0c0c0

# One row of the property panel: name, editable value, a remove button, and a
# dim line under the value showing the widget's current (live) value.
#
# focusable MUST be true here and on propList: recursiveFocus() only focuses
# the focusable levels of the hierarchy (uiwidget.cpp:876) and
# propagateOnKeyText() only descends into focused children (uiwidget.cpp:2082).
# With a non-focusable link in the chain, the row's TextEdit never receives
# what you type.
UiiPropRow < UIWidget
  height: 30
  focusable: true

  UILabel
    id: keyLabel
    width: 120
    height: 16
    anchors.left: parent.left
    anchors.top: parent.top
    text-offset: 2 1
    font: verdana-11px-monochrome
    color: #9fc6e0

  Button
    id: removeBtn
    !text: 'x'
    width: 16
    height: 16
    anchors.right: parent.right
    anchors.top: parent.top

  TextEdit
    id: valueEdit
    height: 18
    anchors.left: keyLabel.right
    anchors.right: removeBtn.left
    anchors.top: parent.top
    margin-left: 2
    margin-right: 3

  UILabel
    id: liveHint
    height: 10
    phantom: true
    anchors.left: keyLabel.right
    anchors.right: parent.right
    anchors.top: valueEdit.bottom
    margin-left: 4
    margin-top: 1
    font: verdana-11px-monochrome
    color: #707070
    !text: ''

Window
  id: uiInspectorWindow
  size: 380 620
  !text: 'UI Inspector'
  anchors.left: parent.left
  anchors.top: parent.top
  margin-left: 12
  margin-top: 40

  UiiSectionLabel
    id: targetTitle
    !text: 'Target'
    margin-top: 0
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right

  Label
    id: infoLabel
    height: 56
    font: verdana-11px-monochrome
    color: #a0d0a0
    text-wrap: true
    text-align: topLeft
    phantom: false
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    !text: 'No widget selected. Toggle edit mode, then Ctrl+Alt+click a widget.'

  Label
    id: mappingBanner
    height: 26
    font: verdana-11px-monochrome
    color: #ff8080
    text-wrap: true
    text-align: topLeft
    phantom: false
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    !text: ''

  # setSourceBtn anchors only to mappingBanner + parent (never back to
  # sourceFileEdit), so the two do not form a widget-level anchor cycle.
  Button
    id: setSourceBtn
    !text: 'Set source'
    height: 20
    width: 90
    anchors.top: mappingBanner.bottom
    anchors.right: parent.right
    margin-top: 2
    @onClick: modules.dev_uiinspector.setSourceFromInput()

  TextEdit
    id: sourceFileEdit
    height: 20
    anchors.top: mappingBanner.bottom
    anchors.left: parent.left
    anchors.right: setSourceBtn.left
    margin-top: 2
    margin-right: 4
    !text: ''

  UiiSectionLabel
    id: modeTitle
    !text: 'Mode'
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  UiiStateCheck
    id: editModeCheck
    !text: 'Edit mode (Ctrl+Alt+I)'
    width: 200
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 4
    @onCheckChange: modules.dev_uiinspector.setEditMode(self:isChecked())

  UiiStateCheck
    id: debugBoxesCheck
    !text: 'All debug boxes'
    width: 150
    anchors.top: prev.top
    anchors.left: prev.right
    margin-left: 8
    @onCheckChange: modules.dev_uiinspector.setDebugBoxes(self:isChecked())

  HorizontalSeparator
    id: sep1
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  UiiSectionLabel
    id: propsTitle
    !text: 'Properties'
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right

  # From propsTitle down the layout is elastic: the property list anchors both
  # top AND bottom, so every pixel gained by resizing the window goes to it.
  TextList
    id: propList
    anchors.top: propsTitle.bottom
    anchors.left: parent.left
    anchors.right: propScroll.left
    anchors.bottom: newPropEdit.top
    margin-top: 2
    margin-bottom: 4
    padding: 1
    focusable: true
    vertical-scrollbar: propScroll

  VerticalScrollBar
    id: propScroll
    anchors.top: propsTitle.bottom
    anchors.bottom: newPropEdit.top
    anchors.right: parent.right
    margin-top: 2
    margin-bottom: 4
    step: 30
    pixels-scroll: true

  TextEdit
    id: newPropEdit
    height: 20
    anchors.bottom: applyBtn.top
    anchors.left: parent.left
    anchors.right: addPropBtn.left
    margin-bottom: 4
    margin-right: 4
    !text: ''

  Button
    id: addPropBtn
    !text: 'Add'
    height: 20
    width: 70
    anchors.bottom: applyBtn.top
    anchors.right: parent.right
    margin-bottom: 4
    @onClick: modules.dev_uiinspector.addPropertyFromInput()

  Button
    id: applyBtn
    !text: 'Apply (live)'
    height: 20
    width: 170
    anchors.bottom: statusLabel.top
    anchors.left: parent.left
    margin-bottom: 4
    @onClick: modules.dev_uiinspector.applyAll()

  Button
    id: saveBtn
    !text: 'Save to file'
    height: 20
    anchors.bottom: statusLabel.top
    anchors.left: applyBtn.right
    anchors.right: parent.right
    margin-left: 4
    margin-bottom: 4
    @onClick: modules.dev_uiinspector.saveFile()

  Label
    id: statusLabel
    font: verdana-11px-monochrome
    color: #dfdf7f
    text-align: topLeft
    text-wrap: true
    phantom: false
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 34
    !text: 'Ready.'

  ResizeBorder
    id: bottomResize
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: -10
    height: 4
    minimum: 420
    maximum: 1400

  ResizeBorder
    id: rightResize
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: -10
    width: 4
    minimum: 340
    maximum: 1000
